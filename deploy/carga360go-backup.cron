# /etc/cron.d/carga360go-backup — respaldo cifrado diario (03:15 hora de Chile = 06:15 UTC; el servidor está en UTC).
# Lo instala deploy/install-backup.sh. Corre como root porque la clave de cifrado es solo de root.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
15 6 * * * root /usr/local/sbin/carga360go-backup >> /var/log/carga360go-backup.log 2>&1
