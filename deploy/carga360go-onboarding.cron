# Recordatorios de registro incompleto (10:00 hora de Chile = 13:00 UTC; el servidor está en UTC).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 13 * * * carga360go /opt/carga360go/deploy/onboarding-jobs.sh recordatorios >> /var/lib/carga360go/onboarding-jobs.log 2>&1
