# Copia este archivo a .env y ajústalo. No subas .env al repositorio.

NODE_ENV=production
APP_URL=https://www.carga360go.cl
DATABASE_PATH=/var/lib/carga360go/carga360go.sqlite
UPLOAD_DIR=/var/lib/carga360go/uploads
BACKUP_DIR=/var/lib/carga360go/backups
BACKUP_KEEP_DAYS=14
MAIL_OUTBOX=/var/lib/carga360go/mail-outbox
COOKIE_SECURE=true
MAX_UPLOAD_BYTES=10485760
TZ=America/Santiago

# Correo de "olvidé mi contraseña". Vacío = no se envía: el enlace queda en MAIL_OUTBOX.
# SMTP_SECURE=true solo con puerto 465. En 587 déjalo en false.
# SMTP_HOST=smtp.tuproveedor.cl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Carga360go <noreply@carga360go.cl>

# Solo para `npm run create-admin`. Nunca dejes la contraseña en el código.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_RUT=
# ADMIN_NAME=Carga360go
# ADMIN_CONTACT=Administrador
# ADMIN_WHATSAPP=+56 9 5842 8693
# ADMIN_CITY=Antofagasta

# Verificación de transportistas (correo + teléfono). Cada canal se activa solo si tiene sus variables.
# Correo: usa las variables SMTP_* de arriba (Google Workspace: smtp.gmail.com, 587, usuario del buzón y contraseña de aplicación).
# OTP de teléfono por WhatsApp.
# Ruta gratuita (recomendada): la persona envía un código al +56 9 5842 8693 con un enlace wa.me.
# Los mensajes entrantes no se cobran. No se responde por WhatsApp (un reply de servicio en Chile
# cuesta CLP 17,6584 según la tarjeta oficial de Meta vigente desde el 1-oct-2026).
# Requiere que el webhook de WhatsApp reciba mensajes (WA_APP_SECRET y, si aplica, WA_PHONE_NUMBER_ID).
# Apagado por defecto.
WHATSAPP_OTP_INBOUND_ENABLED=false
# WHATSAPP_OTP_INBOUND_NUMBER=56958428693
#
# Ruta de pago, opcional: plantilla de autenticación de Meta Cloud API (Chile: CLP 17,6584 por mensaje entregado).
# No está configurada en el servidor hoy. No la actives si quieres mantener el costo en cero.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_OTP_LANG=es
# WHATSAPP_OTP_BUTTON=false  # solo si la plantilla no tiene botón "copiar código"
# WHATSAPP_API_VERSION=v21.0
# OTP por SMS (Twilio), opcional y de respaldo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# --- Bot de WhatsApp (modo coexistencia) ---
# Proveedor: meta (defecto, Cloud API) o 360dialog. El webhook es el mismo:
# https://carga360go.cl/api/whatsapp/webhook  (campos: messages, smb_message_echoes)
WA_PROVIDER=meta
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
# 360dialog (solo si WA_PROVIDER=360dialog). La clave nunca va en el código.
# Envío: POST https://waba-v2.360dialog.io/messages con header D360-API-KEY.
# Webhook: 360dialog reenvía X-Carga360-Secret. Configúralo con:
#   npx tsx scripts/set-360-webhook.ts
# WA_360_API_KEY=
# WA_360_WEBHOOK_SECRET=
# WA_360_WEBHOOK_URL=https://carga360go.cl/api/whatsapp/webhook
# Apagado hasta tener las credenciales. El panel /admin/whatsapp puede encenderlo/apagarlo.
WA_BOT_ENABLED=false
# WA_API_VERSION=v23.0
# WA_HUMAN_PAUSE_HOURS=12
# WA_HANDOFF_EMAIL=contacto@carga360go.cl
# IA compartida (WhatsApp y chat de la web). Sin clave, responde el motor de reglas.
# Gemini (gratis): AI_PROVIDER=gemini y GEMINI_API_KEY. Modelo por defecto: gemini-3.5-flash-lite
# (configurable con GEMINI_MODEL). Timeout 25s. Si Gemini falla, se usa el motor de reglas
# o un aviso con contacto@carga360go.cl.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_MS=25000
# Ruta OpenAI compatible (si no usas Gemini):
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Chat de la web (widget). Apagado por defecto; también se enciende/apaga en /admin/chat.
WEB_CHAT_ENABLED=false

# Código de verificación de Google Search Console (solo el contenido de la meta, no el HTML).
# Cuando lo tengas, descomenta y despliega. No instala analítica ni cookies.
# GOOGLE_SITE_VERIFICATION=

# HubSpot tracking (js.hs-scripts.com/{portalId}.js). Solo se carga tras aceptar cookies de marketing
# en el banner (Ley 21.719). Default = portal de producción. No pongas secretos aquí.
# NEXT_PUBLIC_HUBSPOT_PORTAL_ID=52297745

# --- Pago de fletes con Mercado Pago (Split 1:1, Checkout Pro). APAGADO por defecto. ---
# Solo nombres: los valores reales se cargan por un canal seguro en el servidor de staging, nunca en el repo.
PAYMENTS_FEATURE_ENABLED=false
# Publica Términos 1.1, Privacidad 1.4 y /politica-de-pagos sin abrir el cobro (aviso «disponible próximamente»).
PAYMENTS_LEGAL_PUBLISHED=false
PAYMENTS_MP_ENV=test
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_INTEGRATOR_PUBLIC_KEY=
MP_INTEGRATOR_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_OAUTH_REDIRECT_URI=
MP_NOTIFICATION_URL=
# Solo staging. false (recomendado) = OAuth entrega APP_USR- del vendedor, que es lo que Checkout Pro necesita.
# true entrega tokens TEST- (solo tiene sentido con una app real, y MP rechaza mezclarla con usuarios de prueba).
# MP_OAUTH_TEST_TOKEN=false
# Solo staging: e-mail del comprador de prueba (@testuser.com) para la preferencia. Nunca un correo real ni @staging.
# MP_TEST_PAYER_EMAIL=
# 32 bytes aleatorios en base64 (openssl rand -base64 32). _PREVIOUS solo para rotar.
PAYMENTS_TOKEN_ENCRYPTION_KEY=
PAYMENTS_TOKEN_ENCRYPTION_KEY_PREVIOUS=
PAYMENTS_CRON_SECRET=
# Valores PROPUESTA, no aprobados:
PAYMENTS_ANTICIPO_PERCENT=40
PAYMENTS_FEE_PAYER=shipper
PAYMENTS_MP_FEE_RATE_ESTIMATE=0.0319
PAYMENTS_VAT_RATE=0.19
PAYMENTS_MARKETPLACE_FEE_AMOUNT=0
PAYMENTS_DISPUTE_WINDOW_BUSINESS_HOURS=48
# Feriados de Chile YYYY-MM-DD separados por coma (desde fuente oficial).
PAYMENTS_CL_HOLIDAYS=

# Verificación de identidad con Didit (cédula + prueba de vida + rostro) y copia PDF de la inscripción.
# Apagado por defecto: con false no se muestra nada, las rutas responden 404 y la base no cambia.
KYC_FEATURE_ENABLED=false
# Valores en business.didit.me (nunca en el repo ni por chat):
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
# Opcionales:
# DIDIT_API_BASE=https://verification.didit.me
# DIDIT_ENVIRONMENT=sandbox

# --- Versión 2026-11-15: verificación manual, agente comercial y motor de costos ---
# Todas opcionales. Sin definirlas, lo nuevo queda apagado o en modo sin envío. No pongas valores en el repositorio.
#
# Aviso de verificación manual (solo lectura): el correo usa SMTP_*; WhatsApp necesita WA_ACCESS_TOKEN y WA_PHONE_NUMBER_ID
# (ya existen arriba) más una plantilla aprobada por Meta. Sin eso, el aviso queda en WA_OUTBOX como "no enviado".
# WA_READONLY_TEMPLATE=
# WA_READONLY_REVOKE_TEMPLATE=
# WA_READONLY_TEMPLATE_LANG=es
# WA_OUTBOX=/var/lib/carga360go/whatsapp-outbox
# MANUAL_READONLY_REVOKE_NOTIFY=true   # false = no avisar al revocar
#
# Agente comercial (web, WhatsApp y teléfono). Apagado por defecto; el panel /admin/agente también puede encenderlo.
# AGENT_ENABLED=false
# AGENT_WHATSAPP_ENABLED=false
# AGENT_PHONE_ENABLED=false            # requiere además TWILIO_ACCOUNT_SID y TWILIO_AUTH_TOKEN (servicio de pago)
#
# Motor de costos. Sin claves usa fuentes públicas: OSRM público (rutas), CNE – Bencina en Línea (diésel) y PDF del MOP (peajes).
# COSTOS_CRON_SECRET=                  # 32+ caracteres; lo usa deploy/costos-jobs.sh (cron cada 6 h). El script lo lee de este archivo y no lo pone en la línea de comandos. Sin él, el job no corre.
# COSTOS_API_KEYS=                     # "agente_voz:clave,match:clave" para /api/costos/cotizar desde servicios externos
# COSTOS_DIESEL_ZONAL_ENABLED=true     # false = no consultar el archivo zonal de Bencina en Línea
# CNE_API_TOKEN=                       # API CNE v4 (registro gratuito); sin token: no conectado
# COSTOS_ROUTE_PROVIDER=               # osrm (defecto) | ors_hgv (requiere ORS_API_KEY)
# OSRM_URL=                            # servidor OSRM propio; vacío = router.project-osrm.org
# ORS_API_KEY=                         # OpenRouteService (perfil camión); sin clave: no conectado. Con clave pasa a ser el proveedor activo y no informa tramos con peaje: revisar peajes a mano
# COSTOS_USER_AGENT=                   # User-Agent de las consultas a fuentes públicas

# --- Núcleo operativo (OPS). Apagados por defecto. ---
# Solo el texto exacto true enciende. "TRUE", "1", vacío o con espacios quedan apagados.
# Un flag hijo no hace nada si OPS_FEATURE_ENABLED no es true.
# OPS_ALLOCATION_AUTO se ignora en esta etapa: no hay adjudicación automática.
OPS_FEATURE_ENABLED=false
OPS_PROCUREMENT_ENABLED=false
OPS_ALLOCATION_ENABLED=false
OPS_ALLOCATION_AUTO=false
OPS_API_V1_ENABLED=false
